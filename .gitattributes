# 统一换行符，避免 Windows 上克隆后脚本失效
* text=auto

# shell 脚本必须是 LF，否则 #!/bin/sh\r 会报 bad interpreter
gradlew text eol=lf
*.sh text eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.gif binary
*.apk binary
*.jar binary
*.zip binary
